# 服务端口
PORT=3002
# 日志级别：fatal|error|warn|info|debug|trace|silent
LOG_LEVEL=info

# ===== 大模型（grsai / OpenAI 兼容）=====
# 配了 LLM_API_KEY 即走大模型（激活招投标专家知识）；不配则全程走规则引擎(rule-based)。
LLM_API_KEY=
LLM_BASE_URL=https://grsaiapi.com/v1
LLM_MODEL=gemini-2.5-flash
# 向量检索用的 embedding 模型（OpenAI 兼容）。配了 key 时用它把片段/查询向量化；
# 不配则用确定性哈希向量兜底（离线可测，质量有限）。
EMBEDDING_MODEL=text-embedding-3-small
LLM_TIMEOUT_MS=30000
LLM_MAX_RETRIES=3

# ===== 文档解析微服务（可选，如 MinerU）=====
# 配了才支持上传 PDF/Word/扫描件解析（保留版面页码/条款）；不配时只支持直接提交 text 纯文本（离线可用）。
DOC_SERVICE_URL=
DOC_SERVICE_TIMEOUT_MS=120000

# ===== BIM 解析微服务（可选，IfcOpenShell 风格）=====
# 配了才支持上传 IFC 模型解析成空间/构件/工程量事实；不配时 /bim 录入返回 503（其余功能不受影响）。
BIM_SERVICE_URL=
BIM_SERVICE_TIMEOUT_MS=120000

# ===== RAGFlow 检索引擎（可选，多模态 RAG）=====
# 三者齐备才启用：用 RAGFlow 做语义检索/入库（DeepDoc 解析、向量召回），命中可回链本地 chunk 以保证证据链；
# 不配则用内置向量检索（OpenAI 兼容 embeddings 或哈希兜底），功能不受影响。
# 本地部署 RAGFlow 后，在「用户设置→API」获取 key，并先建好一个 dataset（嵌入模型用本地 rag-service）。
RAGFLOW_BASE_URL=
RAGFLOW_API_KEY=
RAGFLOW_DATASET_ID=
RAGFLOW_TIMEOUT_MS=60000

# ===== 持久化（SQLite）=====
# 文件库路径，目录会自动创建；测试用 :memory: 内存库。
DB_PATH=./data/eng-delivery.db
