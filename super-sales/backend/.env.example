# LLM (OpenAI-compatible). 留空则走纯离线规则兜底，整套流程仍可演示。
LLM_API_KEY=
LLM_BASE_URL=https://api.grsai.com/v1
LLM_MODEL=gpt-5.5
LLM_TIMEOUT_MS=60000

# RAGFlow 多模态 RAG（可选）。三项都填且实例可达时，检索后端自动从本地 BGE 切到 RAGFlow；
# 否则无缝回退本地向量。用 scripts/ragflow_ingest.py 一键建库并打印这三行。
RAGFLOW_API_URL=
RAGFLOW_API_KEY=
RAGFLOW_DATASET_ID=

# AI 背调（theHarvester，仅公开企业信息）。默认免 key 公开源；可覆盖二进制路径/源/超时。
THEHARVESTER_BIN=
THEHARVESTER_SOURCES=hackertarget,crtsh,certspotter,rapiddns
THEHARVESTER_TIMEOUT=60

# 渠道接入（可选，留空则只用沙盒）。填了凭证即真实收发。
# Telegram：@BotFather 一分钟拿 token，免费、可零凭证真机演示。
TELEGRAM_BOT_TOKEN=
TELEGRAM_API_BASE=
# WhatsApp：走开源第三方网关 Evolution API（github.com/EvolutionAPI/evolution-api），
# 扫码登录普通号、无需 Meta 企业资质。把网关 webhook 指向 /api/webhooks/whatsapp。
WA_GATEWAY_BASE=
WA_GATEWAY_API_KEY=
WA_GATEWAY_INSTANCE=
WA_GATEWAY_WEBHOOK_TOKEN=
LINE_CHANNEL_TOKEN=
LINE_API_BASE=
WECOM_CORP_ID=
WECOM_SECRET=
WECOM_AGENT_ID=
WECOM_API_BASE=
