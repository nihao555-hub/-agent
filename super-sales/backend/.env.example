# LLM (OpenAI-compatible). 留空则走纯离线规则兜底，整套流程仍可演示。
LLM_API_KEY=
LLM_BASE_URL=https://api.grsai.com/v1
LLM_MODEL=gpt-5.5
LLM_TIMEOUT_MS=60000

# RAGFlow 多模态 RAG（可选）。三项都填且实例可达时，检索后端自动从本地 BGE 切到 RAGFlow；
# 否则无缝回退本地向量。用 scripts/ragflow_ingest.py 一键建库并打印这三行。
RAGFLOW_API_URL=
RAGFLOW_API_KEY=
RAGFLOW_DATASET_ID=

# AI 背调（theHarvester，仅公开企业信息）。默认免 key 公开源；可覆盖二进制路径/源/超时。
THEHARVESTER_BIN=
THEHARVESTER_SOURCES=hackertarget,crtsh,certspotter,rapiddns
THEHARVESTER_TIMEOUT=60
