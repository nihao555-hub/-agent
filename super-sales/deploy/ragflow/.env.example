# ── AI 超级销售 · RAGFlow 多模态 RAG 一键部署配置 ──────────────────────────
# 复制为 .env 后按需修改；setup.sh 会读取这些值。

# RAGFlow 版本（固定版本，保证可复现）。如需升级改这里。
RAGFLOW_VERSION=v0.20.5

# RAGFlow Web/API 端口（host 侧）。
RAGFLOW_PORT=9380

# Elasticsearch 内存上限。本机内存偏小(8G 左右)用 2g；16G+ 可调到 4g/8g。
ES_MEM_LIMIT=2g

# RAGFlow 服务账号（ragflow_ingest.py 用它注册/登录并签发 API key）。
RAGFLOW_EMAIL=agent@super-sales.local
RAGFLOW_PASSWORD=SuperSales#2026

# ── Embedding 模型来源 ────────────────────────────────────────────────────
# RAGFlow 自身不带 embedding 模型，必须配一个。默认走本地 Ollama + bge-m3
# （免 key、多模态友好）。OLLAMA_MODEL 留空则跳过本地 Ollama，改用下方 hosted key。
OLLAMA_MODEL=bge-m3
# 容器访问宿主机 Ollama 的地址（Linux 用 host.docker.internal，setup.sh 会加 host-gateway）。
OLLAMA_BASE=http://host.docker.internal:11434

# 如果改用 hosted embedding（如 OpenAI / SiliconFlow），填这些、并把 OLLAMA_MODEL 留空：
# RAGFLOW_EMBED_FACTORY=OpenAI
# RAGFLOW_EMBED_MODEL=text-embedding-3-small
# RAGFLOW_EMBED_API_KEY=sk-...
# RAGFLOW_EMBED_BASE_URL=https://api.openai.com/v1
