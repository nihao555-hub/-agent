# 服务端口
PORT=3000
# 日志级别: fatal | error | warn | info | debug | trace | silent
LOG_LEVEL=info

# ===== 大模型配置 (可选) =====
# 不填 LLM_API_KEY 时，后端自动使用内置的"规则引擎"降级方案，无需联网也能返回结果。
# 兼容任意 OpenAI 协议的服务（grsai / OpenAI / DeepSeek / 通义千问 等）。
#
# 默认对接 grsai 代理（实测仅海外 Host + gemini-2.5-flash 可用）：
#   LLM_BASE_URL=https://grsaiapi.com/v1   LLM_MODEL=gemini-2.5-flash
# 切到官方 OpenAI： LLM_BASE_URL=https://api.openai.com/v1  LLM_MODEL=gpt-4o-mini
LLM_API_KEY=
LLM_BASE_URL=https://grsaiapi.com/v1
LLM_MODEL=gemini-2.5-flash
# 单次请求超时(毫秒)
LLM_TIMEOUT_MS=30000
# 瞬时错误(限流/超时)最大重试次数
LLM_MAX_RETRIES=3
