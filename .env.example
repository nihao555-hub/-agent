# 服务端口
PORT=3000
# 日志级别: fatal | error | warn | info | debug | trace
LOG_LEVEL=info

# ===== 大模型配置 (可选) =====
# 不填 LLM_API_KEY 时，后端自动使用内置的"规则引擎"降级方案，无需联网也能返回结果。
# 兼容任意 OpenAI 协议的服务（OpenAI / DeepSeek / Moonshot / 通义千问 等）。
# 例: DeepSeek -> LLM_BASE_URL=https://api.deepseek.com  LLM_MODEL=deepseek-chat
LLM_API_KEY=
LLM_BASE_URL=https://api.openai.com/v1
LLM_MODEL=gpt-4o-mini
# 单次请求超时(毫秒)
LLM_TIMEOUT_MS=30000
