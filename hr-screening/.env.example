PORT=3001
LOG_LEVEL=info

# 大模型（grsai，OpenAI 兼容代理）。留空则全程走规则引擎（离线可用）。
LLM_API_KEY=
LLM_BASE_URL=https://grsaiapi.com/v1
LLM_MODEL=gemini-2.5-flash
LLM_TIMEOUT_MS=30000
LLM_MAX_RETRIES=3

# 简历解析微服务（复用 alibaba/SmartResume，见 resume-service/）。
# 留空则只支持纯文本简历解析（用大模型/规则兜底）；上传 PDF/图片简历需要此服务。
RESUME_SERVICE_URL=
RESUME_SERVICE_TIMEOUT_MS=60000

# OSINT 收集微服务（授权式背调，封装 maigret+sherlock+spiderfoot，见 osint-service/）。
# 留空则 /api/background-check/osint 安全降级（不做任何公开信息收集）。
# 注意：仅在候选人书面授权后才会被调用，且只针对其本人提供/确认的标识。
OSINT_SERVICE_URL=
OSINT_SERVICE_TIMEOUT_MS=120000

# 持久化（SQLite，存储岗位/候选人/对话/投递/事件/通知）。
# 文件库路径；目录会自动创建。测试使用 :memory: 内存库。
DB_PATH=./data/hr.db

# ---- 简历自动归集层 ----
# 批量归集后是否自动跑硬筛+打分（默认 true）。
INTAKE_AUTO_SCREEN=true
# 文件夹归集目录：扫描/监听此目录中的简历（.pdf/.doc/.docx/.txt）自动入库。留空禁用。
INTAKE_WATCH_DIR=
# 文件夹实时监听绑定的岗位 ID（配齐 INTAKE_WATCH_DIR + 此项才启动实时监听）。
INTAKE_WATCH_JOB_ID=

# 企业邮箱 IMAP 收件（配齐 HOST/USER/PASSWORD 才启用；否则邮箱归集安全禁用）。
IMAP_HOST=
IMAP_PORT=993
IMAP_USER=
IMAP_PASSWORD=
IMAP_TLS=true
IMAP_MAILBOX=INBOX

# ---- 实时反馈通知渠道 ----
# 默认渠道：none = dry-run（仅落库不外发，可离线测试）；email = 走 SMTP（nodemailer）。
NOTIFY_DEFAULT_CHANNEL=none
SMTP_HOST=
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
